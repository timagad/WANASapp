# ---------------------------------------------------------------------------
# WANAS — copy to .env and fill in. Never commit .env.
# Everything below has a working default: the platform runs with an empty file.
# ---------------------------------------------------------------------------

# Conversational LLM. Leave blank to run the offline grounded provider
# (extractive answers from the heritage corpus — full demo, zero network).
ANTHROPIC_API_KEY=
WANAS_LLM_MODEL=claude-sonnet-5

# Signing key for access/refresh tokens. Generate: openssl rand -hex 32
WANAS_SECRET_KEY=dev-only-insecure-key-change-me

# Data layer (defaults match docker-compose)
DATABASE_URL=postgresql+psycopg://wanas:wanas@localhost:5432/wanas
REDIS_URL=redis://localhost:6379/0

# Frontend → API
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional third parties (Phase 2+). Blank = feature degrades, never crashes.
MAPS_TILE_URL=
FCM_SERVER_KEY=
